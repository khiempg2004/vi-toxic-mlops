# Bắt buộc: token Hugging Face (dataset uitnlp/vihsd bị gated - cần bấm "Agree" trên trang dataset)
HF_TOKEN=
# Tuỳ chọn: theo dõi thí nghiệm bằng Weights & Biases
WANDB_API_KEY=
WANDB_PROJECT=vi-toxic-mlops

BASE_MODEL=Qwen/Qwen2.5-1.5B-Instruct
VLLM_VERSION=v0.33.0
TRAIN_GPU=0
SERVE_GPU=1
HF_CACHE_DIR=/home/ubuntu/.cache/huggingface
GRAFANA_PASSWORD=admin
